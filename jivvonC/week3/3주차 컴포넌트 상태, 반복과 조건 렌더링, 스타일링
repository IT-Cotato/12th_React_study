      <p>name:  {userInfo.name}</p>
      <p>age:  {userInfo.age}</p>
      <p>gender:  {userInfo.gender}</p>
      <button onClick={handleClick}>Update</button>
    </>
  );
}
```

### 객체 상태 정의하기 심화

객체가 중첩 되어있는 구조

```jsx
export default function App () {
  const [userInfo, setUserInfo]= useState({
    name: 'jack',
    age: 20,
    gender: 'male',
    contact: {
      email: "jack@example.com",
      phone: "123-123-123",
    },
    address: {
      home: {
        street: "123 Main Street",
        city: "Newyork",
        zipCode: "2500"
      },
      office: {
        street: "234 Queens Street",
        city: "San Fransisco",
        zipCode: "4600",
      }
    }
  })

  const handleUpdateUserInfo = () => {
    setUserInfo((userInfo) => ({
      ...userInfo, //이전 값 가져오고
      name: 'mike', // 변경
      contact:{ // 중첩도 똑같이
        ...userInfo.contact, //이전 값 가져오고
        email: "jiwonchon@gmail.com", // 변경
      }
      address:{ //2번 중첩도 똑같이 하면 된다!
        ...userInfo.address,
        office:{
          ...userInfo.address.office,
          street: "345 Cornelia Street",
        }}
    }));
  };

  return (
    <>
	      //중첩 객체까지 출력용
      <pre>{JSON.stringify(userInfo, null, 2)}</pre>
      <button onClick={handleUpdateUserInfo}>Update</button>
    </>
  );
}
```

### 객체 상태 다루기 정리

React에서 상태 업데이트 시 함수형 업데이트 방식은 여러 업데이트가 동시에 발생하거나 비동기적으로 처리될 때 최신 상태를 반영할 수 있도록 도와줍니다.

- **단일 값 업데이트:** 단순히 `name` 같은 값만 변경할 때 사용합니다.
- **중첩 객체 업데이트:** 객체 내부의 특정 값만 업데이트할 때는 해당 객체를 스프레드 연산자로 전개한 후 변경합니다.
- **여러 값 동시에 업데이트:** 여러 중첩된 값을 동시에 변경할 때도, 각 객체별로 스프레드 연산자로 전개한 후 유지하면서 원하는 속성만 덮어씌우면 됩니다.

이처럼 함수형 업데이트를 적절히 활용하면, 복잡한 객체 데이터라고 하더라도 안전하게 상태를 업데이트 할 수 있습니다.

### 배열 상태 다루기

배열 다루기

```jsx
//배열은 괄호 안 넣어도 됨!, 현재 상태 참조니까 함수형 업데이트
export default function App () {
  const [fruits, setFruits] = useState<string[]>(['apple', 'banana', 'orange']);
  const handleAddFruit = () => {
    setFruits((fruits) => 
      [...fruits,
      "melon"]
    )
  }
  return (
    <>
      <p>{fruits.join(", ")}</p> //사이에 콤마 넣어서 출력하기
      <button onClick={handleAddFruit}>Add Fruit</button>
    </>
  );
}
```

apple 만 바꾸고 싶은 경우

```jsx
export default function App () {
  const [fruits, setFruits] = useState<string[]>(['apple', 'banana', 'orange']);
  const handleAddFruit = () => {
    setFruits((fruits) => 
      fruits.map(fruit => fruit === 'apple' ? 'grape': fruit)
      // map으로 돌아가면서 하나씩 검사, 사과면 포도로 바꾸고 아니면 그대로
    );
  }
  return (
    <>
      <p>{fruits.join(", ")}</p>
      <button onClick={handleAddFruit}>Add Fruit</button>
    </>
  );
}
```

사이에 grape 넣기

```jsx
export default function App () {
  const [fruits, setFruits] = useState<string[]>(['apple', 'banana', 'orange']);
  const handleAddFruit = () => {
    setFruits((fruits) => 
    [...fruits.slice(0,1), 'grape', ...fruits.slice(1) ]
    );
  }
  return (
    <>
      <p>{fruits.join(", ")}</p>
      <button onClick={handleAddFruit}>Add Fruit</button>
    </>
  );
}
```

### 상태 독립성 이해하기

컴포넌트 내에서 정의된 상태값들은 그 컴포넌트 내에서만 유효함

React가 상태 업데이트를 반영해서 화면에 갱신 할 수 있는 원리는 ‘리렌더링’

함수형 컴포넌트에서는 ‘함수가 다시 실행된다는  것’

중요한 점!

컴포넌트가 리렌더링 되는 건 그 상태가 업데이트 된 그 컴포넌트 만!!!! 리렌더링 된다!!

>리렌더링도 독립적으로 된다

### 상태 끌어올리기

그러면 자식들이 각각 독립적으로 자기 상태 관리하는게 아니라 하나의 상태를 공유하게 만들고 싶다면?

두 컴포넌트의 공통적인 부모 또는 조상 컴포넌트에서 상태를 정의하고 해당 상태와 상태 업데이트 함수를 props로 전달하는 것

```jsx
//App.tsx
export default function App () {
const [count, setCount] = useState(0);
  return (
    <>
    <FirstCount count={count} setCount={setCount}/>
    <SecondCount count={count} setCount={setCount}/>
    </>
  );
}

//FirstCount.tsx
export default function FirstCount ({count,setCount}:{
    count: number; 
    setCount: Dispatch<SetStateAction<number>>;
}) {

  return (
    <>
      <h1>FirstCount Component: {count}</h1>
      <button onClick={() => setCount((count) => count + 1)}>increment</button>
    </>
  );
}

//SecondCount.tsx
export default function SecondCount ({count,setCount}:{
    count: number; 
    setCount: Dispatch<SetStateAction<number>>;
}) {

  return (
    <>
      <h1>SecondCount Component: {count}</h1>
      <button onClick={() => setCount((count) => count + 1)}>increment</button>
    </>
  );
}
```

### 캡슐화 이해하기

상태 업데이트 함수를 직접 자식 컴포넌트에 props로 전달하면 자식 컴포넌트에 대한 굉장한 자유도를 줌 
> 권장X

그래서 보통은 상태 업데이트 함수를 바로 넘겨주는 것 보다는 상태 업데이트 로직을 구현한 함수를 넘겨주는 것이 좋음

특정 함수 내부의 상태 업데이트 로직을 구현하는 것 > 캡슐화

숫자를 1 증가 시킬 수 있도록 내부(부모)에 작성해서 외부(자식)에서는 접근하지 못하게

```jsx
//App.tsx
export default function App () {
const [count, setCount] = useState(0);
const handleIncrement =() => {
  setCount((count) => count +1)
}
  return (
    <>
    <FirstCount count={count} setCount={setCount} handleIncrement={handleIncrement}/>
    <SecondCount count={count} setCount={setCount} handleIncrement={handleIncrement}/>
    </>
  );
}

//FirstCount.tsx
import { useState, type Dispatch, type SetStateAction } from "react";

export default function FirstCount ({count,setCount, handleIncrement}:{
    count: number; 
    setCount: Dispatch<SetStateAction<number>>;
    handleIncrement: () => void;
}) {

  return (
    <>
      <h1>FirstCount Component: {count}</h1>
      <button onClick={handleIncrement}>increment</button>
    </>
  );
}

//Second.tsx
export default function SecondCount ({count,setCount, handleIncrement}:{
    count: number; 
    setCount: Dispatch<SetStateAction<number>>;
    handleIncrement: () => void;
}) {

  return (
    <>
      <h1>SecondCount Component: {count}</h1>
      <button onClick={handleIncrement}>increment</button>
    </>
  );
}
```

이렇게 캡슐화를 하면 업데이트 로직을 변경해야 할 때에도 이렇게 한 곳에서만 변경해주면 되기 때문에 유지보수도 더 편리하다는 장점이 있음.

### 리액트 훅 공통 규칙

1. **리액트 훅은 use로 시작해야 한다.**

리액트에서 사용하는 모든 훅은 `use`로 시작합니다.

`useState`도 리액트 훅의 한 종류이기 때문에 `use`로 시작했습니다.

이후에 배우는 여러 가지 훅도 `use`로 시작합니다.

2. **훅은 최상위에서만 호출되어야 한다.**

훅은 컴포넌트 함수의 최상위에서만 호출해야 합니다.

조건문이나 반복문 내에서 호출하면 안 됩니다.

**잘못된 예제:**

```jsx
function MyComponent(props) {
  if (props.isLoggedIn) {
    const [user, setUser] = useState(null);  // 조건문 안에서 훅 호출
  }
  return <div>{user}</div>;
}
```

**올바른 예제:**

```jsx
function MyComponent(props) {
  const [user, setUser] = useState(null);  // 최상위에서 호출

  if (props.isLoggedIn) {
    setUser({ name: 'John' });
  }

  return <div>{user ? user.name : 'Guest'}</div>;
}
```

### useReducer-1

컴포넌트의 상태를 정의하는 또다른 방법

useState 훅에 비해서 복잡한 상태 관리를 하는데 효율적임

```jsx
const [state, dispatch] = useReducer<Type>(reducer, initialState);
```

`reducer`: 함수 형태의 값(리듀서 함수), useReducer에서 현재 상태 값을 결정하는 역할을 함

`dispatch`: 리듀서 함수에 전달해서 새로운 상태값을 설정하게 하는 함수(액션 발생 함수)

`Type`: 리듀서 훅의 제네릭 타입은 일반적으로 지정하기가 까다로워서 되도록이면 타입 추론을 통해서 자동으로 지정되도록 그대로 냅둠.

### useReducer-2

```jsx
import { useReducer } from "react";

function reducer(count: number, action: {type: string}){
  switch(action.type){
    case "INCREMENT":
      return count+1;
    case "DECREMENT":
      return count-1;
    case "RESET":
      return 0;
    default:
      return count;
  }
}

export default function App () {
  const [count, countDispatch] = useReducer(reducer, 0);
  return (
    <>
    <h1>Count: {count}</h1>
    <button onClick={()=> countDispatch({type: "INCREMENT"})}>increase</button>
    <button onClick={()=> countDispatch({type: "DECREMENT"})}>decrease</button>
    <button onClick={()=> countDispatch({type: "RESET"})}>reset</button>
    </>
  );
}
```

useReducer 훅은 useState와 다르게 상태값을 변경할 수 있는 로직이 오직 첫번째 매개변수로 전달한  리듀서 함수 내부에만 있어서 useState보다는 복잡한 상태를 다루기 더 좋은 상태 정의 방법이다

reducer함수는 별도의 파일으로 빼는 것도 가능함!
